@page
@model CompareModel
@{
	ViewData["Title"] = T["Compare banks"];
	ViewData["Nav"] = "compare";
	var code = Model.Currency ?? "";
	var quote = Model.QuoteCurrency ?? "";
	var all = Model.AllCountries;
}

<main class="container">
	<h1 class="page-title">@T["Compare banks"]</h1>

	<form method="get" class="filters cmp-filters">
		@{
			var chosen = Model.Countries.Where(c => Model.ChosenCountries.Contains(c.Code)).ToList();
			var pickerLabel = chosen.Count == 0 ? T["Choose countries"]
				: Model.EveryCountry && chosen.Count > 1 ? T["All countries"]
				: chosen.Count <= 2 ? string.Join(", ", chosen.Select(c => c.Name))
				: T.Format("{0} +{1} more", chosen[0].Name, chosen.Count - 1);
		}
		<div class="field ms" data-ms
			 data-text-choose="@T["Choose countries"]" data-text-all="@T["All countries"]" data-text-more="@T["{0} +{1} more"]"
			 data-text-one="@T["Comparing prices in {0}"]" data-text-many="@T["Comparing {0} countries by spread"]" data-text-none="@T["Pick at least one"]">
			<button type="button" class="ms-trigger" aria-haspopup="true" aria-expanded="false">
				<span>@T["Countries"]</span>
				<span class="ms-value"><span class="ms-label" data-ms-label>@pickerLabel</span><span class="ms-count" data-ms-count>@chosen.Count</span></span>
			</button>
			<div class="ms-panel" hidden>
				<div class="checklist">
					<label class="cl-search">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#667085" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
						<input type="text" data-ms-search placeholder="@T["Search countries"]" aria-label="@T["Search countries"]" />
					</label>
					<label class="cl-all"><input type="checkbox" data-ms-all /><span>@T["All countries"]</span></label>
					<div class="cl-list">
						@foreach (var c in Model.Countries)
						{
							<label class="cl-item" data-ms-item="@c.Name">
								<input type="checkbox" name="countries" value="@c.Code" checked="@Model.ChosenCountries.Contains(c.Code)" />
								<span style="flex:1">@c.Name</span>
							</label>
						}
						<div class="cl-empty" data-ms-empty hidden>@T["No matches."]</div>
					</div>
				</div>
				<div class="ms-foot"><span data-ms-hint></span><button type="submit" class="btn-done">@T["Done"]</button></div>
			</div>
		</div>
		<label class="field">
			<span>@T["Currency"]</span>
			<select name="currency" onchange="this.form.submit()">
				<button><selectedcontent></selectedcontent></button>
				@foreach (var c in Model.Currencies)
				{
					<option value="@c.Code" selected="@(c.Code == Model.Currency)">@c.Code — @c.Name</option>
				}
			</select>
		</label>
		<label class="field">
			<span>@T["Date"]</span>
			<input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
				data-datepicker data-empty="@T["Latest"]" data-today="@T["Today"]" data-clear="@T["Clear"]" data-prev="@T["Previous month"]" data-next="@T["Next month"]" />
		</label>
		<div class="field f-toggle">
			<span>@T["I want to"]</span>
			<div class="seg" role="radiogroup">
				<label class="seg-option">
					<input type="radio" name="side" value="buy" checked="@Model.Buying" onchange="this.form.submit()" />
					<span>@T.Format("Buy {0}", code)</span>
				</label>
				<label class="seg-option">
					<input type="radio" name="side" value="sell" checked="@(!Model.Buying)" onchange="this.form.submit()" />
					<span>@T.Format("Sell {0}", code)</span>
				</label>
			</div>
		</div>
		<label class="field f-amount">
			<span>@T["Amount"]</span>
			<input class="num" type="text" name="amount" inputmode="decimal" value="@Model.AmountDisplay" />
		</label>
		<div class="actions">
			<button type="submit" class="btn btn-primary">@T["Compare"]</button>
		</div>
	</form>

	@* Below the table (and the cards on a phone): how many banks are compared, and "+ Add a bank" with the others. *@
	@{
		var refTag = T["A central bank’s reference rate: one middle rate, published for information, not a bank’s buying and selling prices."];
		void BanksFoot(string note)
		{
			<span>@T.Format("Showing {0} of {1} bank(s)", Model.ChosenBanks.Count, Model.BanksQuoting) · @note</span>
			if (Model.OtherBanks.Count > 0)
			{
				<details class="add-bank" data-add-bank>
					<summary class="btn-ghost">@T["+ Add a bank"]</summary>
					<ul class="add-bank-list">
						@foreach (var (other, otherRate) in Model.OtherBanks)
						{
							<li>
								<a href="@Model.AddBankUrl(other.Bic)">
									<b>@other.DisplayName</b>
									<small>@(other.FullName is null ? "" : other.FullName + " · ")<span class="num">@other.Bic</span>@(all && otherRate.CountryName is { } cn ? " · " + cn : "")</small>
								</a>
							</li>
						}
					</ul>
				</details>
			}
		}
		void RemoveBank(BankRates bank)
		{
			if (Model.RemoveBankUrl(bank.Bic) is { } removeUrl)
			{
				<a class="remove-bank" href="@removeUrl" aria-label="@T.Format("Remove {0}", bank.DisplayName)" title="@T.Format("Remove {0}", bank.DisplayName)">×</a>
			}
		}
	}

	@if (Model.Error is not null)
	{
		<p class="notice error">@Model.Error</p>
	}
	else if (Model.Rows.Count == 0 && Model.AllRows.Count == 0)
	{
		<p class="notice">
			@(Model.Date is { } d
				? T.Format("No rates match this search on or before {0}.", RateFormat.FormatDate(d))
				: T["No rates match this search."])
		</p>
	}
	else if (!all)
	{
		var cheapest = Model.CheapestToBuy;
		var best = Model.BestToSell;
		var (difference, compared) = Model.BestVsWorst;

		<div class="summary">
			<div class="card" style="--c:#F97316">
				<small>@T.Format("Cheapest place to buy {0}", code)</small>
				@if (cheapest is { } c)
				{
					<strong>@(c.Bank.DisplayName)@if (c.Bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</strong>
					@if (c.Bank.FullName is not null) { <small class="bank-full-name">@c.Bank.FullName</small> }
					<p>
						@T["Sells at"] <b class="num" style="color:#C2410C">@RateFormat.Format(c.Rate.SellingRate)</b>
						· @T["you pay"] <b class="num nowrap">@RateFormat.FormatAmount(c.Rate.SellingRate * Model.Amount, quote) @quote</b>
					</p>
				}
				else
				{
					<strong>—</strong>
				}
			</div>
			<div class="card" style="--c:#0369A1">
				<small>@T.Format("Best place to sell {0}", code)</small>
				@if (best is { } b)
				{
					<strong>@(b.Bank.DisplayName)@if (b.Bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</strong>
					@if (b.Bank.FullName is not null) { <small class="bank-full-name">@b.Bank.FullName</small> }
					<p>
						@T["Buys at"] <b class="num" style="color:#0369A1">@RateFormat.Format(b.Rate.BuyingRateTransfer)</b>
						· @T["you get"] <b class="num nowrap">@RateFormat.FormatAmount(b.Rate.BuyingRateTransfer * Model.Amount, quote) @quote</b>
					</p>
				}
				else
				{
					<strong>—</strong>
				}
			</div>
			<div class="card" style="--c:#6D28D9">
				<small>@T["Difference best vs. worst"]</small>
				<strong class="num" style="color:#6D28D9">@RateFormat.FormatAmount(difference, quote) @quote</strong>
				<p>@T.Format("on {0} {1} across {2} bank(s)", Model.AmountDisplay, code, compared)</p>
			</div>
		</div>

		<section class="bank cmp-desktop">
			<div class="cmp-head">
				<div>
					<h2>@T.Format("{0} at banks in {1}", code, Model.CountryName ?? "")</h2>
					<p>
						@T.Format("Rates of {0}", RateFormat.FormatDate(Model.Rows.Max(r => r.Rate.Date)))
						· @(Model.SortBy switch { "buy" => T["sorted by highest buy rate"], "spread" => T["sorted by lowest spread"], _ => T["sorted by lowest sell rate"] })
						@if (quote.Length > 0)
						{
							<text>· @T.Format("all values in {0}", quote)</text>
						}
					</p>
				</div>
				<nav class="seg light" aria-label="@T["Sort"]">
					<a href="@Model.PageUrl("sell")" aria-current="@(Model.SortBy == "sell" ? "true" : null)">@T["Sell rate"]</a>
					<a href="@Model.PageUrl("buy")" aria-current="@(Model.SortBy == "buy" ? "true" : null)">@T["Buy rate"]</a>
					<a href="@Model.PageUrl("spread")" aria-current="@(Model.SortBy == "spread" ? "true" : null)">@T["Spread"]</a>
				</nav>
			</div>
			<div class="table-wrap">
				<table class="cmp-table">
					<thead>
						<tr>
							<th>@T["Bank"]</th>
							<th>@T["Buy · cash"]</th>
							<th>@T["Buy · transfer"]</th>
							<th>@T["Sell"]</th>
							<th>@T["Spread"]</th>
							<th>@T.Format("You pay for {0} {1}", Model.AmountDisplay, code)</th>
							<th class="remove-col"><span class="sr-only">@T["Remove"]</span></th>
						</tr>
					</thead>
					<tbody>
						@for (var i = 0; i < Model.Rows.Count; i++)
						{
							var (bank, rate) = Model.Rows[i];
							var colour = RateFormat.BankColours[i % RateFormat.BankColours.Count];
							<tr>
								<td>
									<span class="bank-cell">
										<span class="bank-dot" style="background:@colour.Tint;color:@colour.Colour">@bank.Badge</span>
										<span>
											<b>@(bank.DisplayName)@if (bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</b>
											@if (bank.FullName is not null) { <small class="bank-full-name">@bank.FullName</small> }
											<small>
												<span class="num">@bank.Bic</span>
												@if (rate.RateTime is { } t)
												{
													<text> · @RateFormat.FormatPublished(t)</text>
												}
											</small>
										</span>
									</span>
								</td>
								<td class="num @(rate.BuyingRateCash is null ? "na" : "")">@RateFormat.Format(rate.BuyingRateCash)</td>
								<td class="num @(rate.BuyingRateTransfer is null ? "na" : "")">@RateFormat.Format(rate.BuyingRateTransfer)</td>
								<td class="num sell @(rate.SellingRate is null ? "na" : "")">@RateFormat.Format(rate.SellingRate)</td>
								<td class="num muted-num">@RateFormat.FormatSpread(RateFormat.Spread(rate))</td>
								<td class="num strong-num">@RateFormat.FormatAmount(rate.SellingRate * Model.Amount, quote)</td>
								<td class="remove-col">@{ RemoveBank(bank); }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="cmp-foot">
				@{ BanksFoot(T["“You pay” = amount × sell rate"]); }
			</div>
		</section>

		<div class="bank-cards">
			@for (var i = 0; i < Model.Rows.Count; i++)
			{
				var (bank, rate) = Model.Rows[i];
				var colour = RateFormat.BankColours[i % RateFormat.BankColours.Count];
				<section class="card bank-card">
					<div class="top">
						<span class="bank-cell">
							<span class="bank-dot" style="background:@colour.Tint;color:@colour.Colour">@bank.Badge</span>
							<span>
								<b>@(bank.DisplayName)@if (bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</b>
								@if (bank.FullName is not null) { <small class="bank-full-name">@bank.FullName</small> }
								<small>@bank.Bic@(rate.RateTime is { } t ? " · " + RateFormat.FormatPublished(t) : "")</small>
							</span>
						</span>
						<span class="bank-card-sell">
							<small>@T["Sell"]</small>
							<span class="num sell">@RateFormat.Format(rate.SellingRate)</span>
						</span>
						@{ RemoveBank(bank); }
					</div>
					<div class="grid">
						<span><small>@DotLabel.BreakOnlyAfterDot(T["Buy · cash"])</small><span class="num">@RateFormat.Format(rate.BuyingRateCash)</span></span>
						<span><small>@DotLabel.BreakOnlyAfterDot(T["Buy · transfer"])</small><span class="num">@RateFormat.Format(rate.BuyingRateTransfer)</span></span>
						<span class="end"><small>@T.Format("Pay for {0}", Model.AmountDisplay)</small><span class="num strong-num">@RateFormat.FormatAmount(rate.SellingRate * Model.Amount, quote)</span></span>
					</div>
				</section>
			}
			<div class="card cmp-foot cards-foot">
				@{ BanksFoot(T["“You pay” = amount × sell rate"]); }
			</div>
		</div>
	}
	else
	{
		var lowest = Model.LowestSpread;
		var bestCountry = Model.BestCountry;
		decimal maxSpread = Model.Rows.Select(r => RateFormat.Spread(r.Rate)).OfType<decimal>().DefaultIfEmpty(0m).Max();
		int Bar(decimal? s) => s is { } v && maxSpread > 0 ? (int)Math.Round(Math.Clamp(v / maxSpread, 0m, 1m) * 100m) : 0;

		<div class="summary">
			<div class="card" style="--c:#F97316">
				<small>@T.Format("Lowest {0} spread anywhere", code)</small>
				@if (lowest is { } l)
				{
					<strong>@(l.Bank.DisplayName)@if (l.Bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</strong>
					@if (l.Bank.FullName is not null) { <small class="bank-full-name">@l.Bank.FullName</small> }
					<p>@(l.Rate.CountryName ?? "—") · @T["spread"] <b class="num" style="color:#C2410C">@RateFormat.FormatSpread(l.Spread)</b></p>
				}
				else
				{
					<strong>—</strong>
				}
			</div>
			<div class="card" style="--c:#0369A1">
				<small>@T.Format("Best country for {0}", code)</small>
				@if (bestCountry is { } bc)
				{
					<strong>@bc.Country</strong>
					<p>@T["Average spread"] <b class="num" style="color:#0369A1">@RateFormat.FormatSpread(bc.AverageSpread)</b> @T.Format("across {0} bank(s)", bc.Banks)</p>
				}
				else
				{
					<strong>—</strong>
				}
			</div>
			<div class="card" style="--c:#6D28D9">
				<small>@T["Coverage"]</small>
				<strong>@T.Format("{0} country(ies) · {1} bank(s)", Model.CoverageCountries, Model.AllRows.Count)</strong>
				<p>@T["Each bank’s rates are in its local currency"]</p>
			</div>
		</div>

		<section class="bank cmp-desktop">
			<div class="cmp-head">
				<div>
					<h2>@(Model.EveryCountry ? T.Format("{0} at banks in all countries", code) : T.Format("{0} at banks in {1} countries", code, Model.ChosenCountries.Count))</h2>
					<p>
						@T.Format("Rates of {0}", RateFormat.FormatDate(Model.AllRows.Max(r => r.Rate.Date)))
						· @(Model.SortBy == "country" ? T["sorted by country"] : T["sorted by lowest spread"])
						· @T["rates in each bank’s local currency"]
					</p>
				</div>
				<div class="cmp-tools">
					<form method="get">
						@foreach (var c in Model.ChosenCountries)
						{
							<input type="hidden" name="countries" value="@c" />
						}
						<input type="hidden" name="currency" value="@Model.Currency" />
						<input type="hidden" name="date" value="@Model.Date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
						<input type="hidden" name="side" value="@(Model.Buying ? "buy" : "sell")" />
						<input type="hidden" name="sort" value="@Model.SortBy" />
						<input type="hidden" name="amount" value="@Model.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
						@if (Model.BanksChosen)
						{
							foreach (var bic in Model.ChosenBanks)
							{
								<input type="hidden" name="banks" value="@bic" />
							}
						}
						<select class="pill-select" name="only" aria-label="@T["Filter by country"]" onchange="this.form.submit()">
							<option value="">@T["All countries"]</option>
							@foreach (var c in Model.RowCountries)
							{
								<option value="@c.Code" selected="@(string.Equals(c.Code, Model.Only, StringComparison.OrdinalIgnoreCase))">@c.Name</option>
							}
						</select>
					</form>
					<nav class="seg light" aria-label="@T["Sort"]">
						<a href="@Model.PageUrl("spread")" aria-current="@(Model.SortBy == "spread" ? "true" : null)">@T["Spread"]</a>
						<a href="@Model.PageUrl("country")" aria-current="@(Model.SortBy == "country" ? "true" : null)">@T["Country"]</a>
					</nav>
				</div>
			</div>
			<div class="table-wrap">
				<table class="cmp-table cmp-all">
					<thead>
						<tr>
							<th>@T["Bank"]</th>
							<th class="left">@T["Country"]</th>
							<th>@T["Buy · transfer"]</th>
							<th>@T["Sell"]</th>
							<th class="left spread-col">@T["Spread"]</th>
							<th>@T.Format("You pay for {0} {1}", Model.AmountDisplay, code)</th>
							<th class="remove-col"><span class="sr-only">@T["Remove"]</span></th>
						</tr>
					</thead>
					<tbody>
						@for (var i = 0; i < Model.Rows.Count; i++)
						{
							var (bank, rate) = Model.Rows[i];
							var colour = RateFormat.BankColours[i % RateFormat.BankColours.Count];
							var spread = RateFormat.Spread(rate);
							<tr>
								<td>
									<span class="bank-cell">
										<span class="bank-dot" style="background:@colour.Tint;color:@colour.Colour">@bank.Badge</span>
										<span><b>@(bank.DisplayName)@if (bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</b>@if (bank.FullName is not null) { <small class="bank-full-name">@bank.FullName</small> }<small class="num">@bank.Bic</small></span>
									</span>
								</td>
								<td class="left">
									<span class="country-cell"><b>@(rate.CountryName ?? "—")</b>@if (rate.QuoteCurrencyCode is { } q) { <span class="ccy">@q</span> }</span>
								</td>
								<td class="num @(rate.BuyingRateTransfer is null ? "na" : "")">@RateFormat.Format(rate.BuyingRateTransfer)</td>
								<td class="num sell @(rate.SellingRate is null ? "na" : "")">@RateFormat.Format(rate.SellingRate)</td>
								<td class="left spread-col">
									<span class="spread">
										<span class="bar"><i style="width:@(Bar(spread))%"></i></span>
										<span class="num">@RateFormat.FormatSpread(spread)</span>
									</span>
								</td>
								<td class="num strong-num nowrap">@RateFormat.FormatAmount(rate.SellingRate * Model.Amount, rate.QuoteCurrencyCode)@if (rate.SellingRate is not null && rate.QuoteCurrencyCode is { } payIn) { <span class="pay-ccy">@payIn</span> }</td>
								<td class="remove-col">@{ RemoveBank(bank); }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="cmp-foot">
				@{ BanksFoot(T["Rates are in each bank’s local currency, so banks in different countries are compared by spread."]); }
			</div>
		</section>

		<div class="bank-cards">
			@for (var i = 0; i < Model.Rows.Count; i++)
			{
				var (bank, rate) = Model.Rows[i];
				var colour = RateFormat.BankColours[i % RateFormat.BankColours.Count];
				<section class="card bank-card">
					<div class="top">
						<span class="bank-cell">
							<span class="bank-dot" style="background:@colour.Tint;color:@colour.Colour">@bank.Badge</span>
							<span>
								<b>@(bank.DisplayName)@if (bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@refTag">@T["Reference rate"]</span> }</b>
								@if (bank.FullName is not null) { <small class="bank-full-name">@bank.FullName</small> }
								<small>@(rate.CountryName ?? "—") @if (rate.QuoteCurrencyCode is { } q) { <span class="ccy">@q</span> }</small>
							</span>
						</span>
						<span class="bank-card-sell">
							<small>@T["Spread"]</small>
							<span class="num spread-big">@RateFormat.FormatSpread(RateFormat.Spread(rate))</span>
						</span>
						@{ RemoveBank(bank); }
					</div>
					<div class="grid">
						<span><small>@DotLabel.BreakOnlyAfterDot(T["Buy · transfer"])</small><span class="num">@RateFormat.Format(rate.BuyingRateTransfer)</span></span>
						<span><small>@T["Sell"]</small><span class="num kv-sell">@RateFormat.Format(rate.SellingRate)</span></span>
						<span class="end"><small>@T.Format("Pay for {0}", Model.AmountDisplay)</small><span class="num strong-num">@RateFormat.FormatAmount(rate.SellingRate * Model.Amount, rate.QuoteCurrencyCode)@if (rate.SellingRate is not null && rate.QuoteCurrencyCode is { } payIn) { <span class="pay-ccy">@payIn</span> }</span></span>
					</div>
				</section>
			}
			<div class="card cmp-foot cards-foot">
				@{ BanksFoot(T["Rates are in each bank’s local currency, so banks in different countries are compared by spread."]); }
			</div>
		</div>
	}

	<p class="footnote">@T["Rates are indicative and taken from each bank’s published table. Always confirm with the bank before exchanging."]</p>
</main>

@page
@model IndexModel
@{
	ViewData["Title"] = "Latest bank rates";
}

<div class="container">
	<form method="get" class="filters">
		<label class="field f-country">
			<span>Country</span>
			<select name="country" onchange="this.form.submit()">
				<option value="">All countries</option>
				@foreach (var c in Model.Countries)
				{
					<option value="@c.Code" selected="@(string.Equals(c.Code, Model.Country, StringComparison.OrdinalIgnoreCase))">@c.Name</option>
				}
			</select>
		</label>
		<label class="field f-date">
			<span>Date</span>
			<input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" />
		</label>
		<label class="field f-bank">
			<span>Bank name or BIC</span>
			<input type="search" name="bank" value="@Model.Bank" list="banks" placeholder="e.g. Vietcombank or BFTVVNVX" autocomplete="off" />
			<datalist id="banks">
				@foreach (var b in Model.Banks)
				{
					<option value="@b.Bic">@b.Name</option>
				}
			</datalist>
		</label>
		<div class="actions">
			<a asp-page="/Index" class="btn btn-secondary">Reset</a>
			<button type="submit" class="btn btn-primary">Show rates</button>
		</div>
	</form>
</div>

<main class="container">
	@if (Model.Error is not null)
	{
		<p class="notice error">@Model.Error</p>
	}
	else if (Model.Results is null)
	{
		<p class="notice">
			Choose a country, a date or a bank to see the latest rates.
			@if (Model.Banks.Count > 0)
			{
				<span>@Model.Banks.Count bank(s) have rates.</span>
			}
		</p>
	}
	else if (Model.Results.Count == 0)
	{
		<p class="notice">
			No rates match this search@(Model.Date is { } d ? " on or before " + d.ToString("dd/MM/yyyy") : "").
		</p>
	}
	else
	{
		var featured = Model.Featured;
		if (featured.Count > 0)
		{
			<div class="featured">
				@foreach (var f in featured)
				{
					var spread = IndexModel.Spread(f);
					<div class="fcard @IndexModel.FeaturedTheme(f.CurrencyCode)">
						<div class="fcard-head">
							<span class="fcard-id">
								<span class="sym">@(f.CurrencySymbol ?? f.CurrencyCode[..1])</span>
								<span>
									<span class="fcard-code">@f.CurrencyCode</span>
									<span class="fcard-name">@f.CurrencyName</span>
								</span>
							</span>
							<span class="badge">Spread @IndexModel.FormatSpread(spread)</span>
						</div>
						<div class="fcard-rates">
							<div><small>We buy</small><span class="num">@IndexModel.Format(f.BuyingRateTransfer)</span></div>
							<div><small>We sell</small><span class="num sell">@IndexModel.Format(f.SellingRate)</span></div>
						</div>
					</div>
				}
			</div>
		}

		foreach (var bank in Model.Results)
		{
			<section class="bank" data-rates>
				<div class="bank-head">
					<div class="bank-id">
						<span class="bank-badge">@bank.Badge</span>
						<div>
							<h2>@bank.ShortName</h2>
							<p>
								@(bank.LegalName ?? bank.Name)
								@if (bank.CountryName is not null)
								{
									<span> · @bank.CountryName</span>
								}
							</p>
						</div>
					</div>
					<div class="chips">
						<span class="chip blue num">@bank.Bic</span>
						@if (bank.SameDate)
						{
							<span class="chip orange">Rates of @bank.LastDate.ToString("dd/MM/yyyy")</span>
						}
						else
						{
							<span class="chip orange">Rates of @bank.FirstDate.ToString("dd/MM/yyyy") to @bank.LastDate.ToString("dd/MM/yyyy")</span>
						}
						@if (bank.PublishedAt is { } published)
						{
							<span class="chip">Published @published.ToString("dd/MM HH:mm") (@IndexModel.FormatOffset(published.Offset))</span>
						}
					</div>
				</div>
				<div class="toolbar">
					<label class="search">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#667085" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
						<input type="search" aria-label="Filter currencies" placeholder="Filter currencies" data-filter />
					</label>
					<span class="hint">
						@if (bank.QuoteCurrency is not null)
						{
							<text>All rates in @bank.QuoteCurrency · </text>
						}
						“—” means the bank doesn’t quote this rate
					</span>
				</div>
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th>Currency</th>
								<th>Buy · cash</th>
								<th>Buy · transfer</th>
								<th>Sell</th>
								<th>Spread</th>
							</tr>
						</thead>
						<tbody>
							@for (var i = 0; i < bank.Rates.Count; i++)
							{
								var r = bank.Rates[i];
								var spread = IndexModel.Spread(r);
								<tr data-search="@($"{r.CurrencyCode} {r.CurrencyName}".ToLowerInvariant())">
									<td>
										<span class="cur">
											<span class="pill p@(i % 5)">@r.CurrencyCode</span>
											<span class="cur-name">@r.CurrencyName</span>
											@if (!bank.SameDate)
											{
												<span class="cur-date">@r.Date.ToString("dd/MM/yyyy")</span>
											}
										</span>
									</td>
									<td class="num @(r.BuyingRateCash is null ? "na" : "")">@IndexModel.Format(r.BuyingRateCash)</td>
									<td class="num @(r.BuyingRateTransfer is null ? "na" : "")">@IndexModel.Format(r.BuyingRateTransfer)</td>
									<td class="num sell @(r.SellingRate is null ? "na" : "")">@IndexModel.Format(r.SellingRate)</td>
									<td>
										<span class="spread">
											<span class="bar"><i style="width:@(bank.SpreadBarWidth(spread))%"></i></span>
											<span class="num">@IndexModel.FormatSpread(spread)</span>
										</span>
									</td>
								</tr>
							}
							<tr class="no-match" hidden><td colspan="5">No currency matches this filter.</td></tr>
						</tbody>
					</table>
				</div>
			</section>
		}

		<p class="footnote">Rates are indicative and taken from the bank’s published table. Spread = (sell − buy transfer) ÷ buy transfer.</p>
	}
</main>

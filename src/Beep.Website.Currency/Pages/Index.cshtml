@page
@model IndexModel
@{
	ViewData["Title"] = T["Latest bank rates"];
}

<div class="container">
	<form method="get" class="filters">
		<label class="field f-country">
			<span>@T["Country"]</span>
			<select name="country" onchange="this.form.submit()">
				<option value="">@T["All countries"]</option>
				@foreach (var c in Model.Countries)
				{
					<option value="@c.Code" selected="@(string.Equals(c.Code, Model.Country, StringComparison.OrdinalIgnoreCase))">@c.Name</option>
				}
			</select>
		</label>
		<label class="field f-date">
			<span>@T["Date"]</span>
			<input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
				data-datepicker data-empty="@T["Latest"]" data-today="@T["Today"]" data-clear="@T["Clear"]" data-prev="@T["Previous month"]" data-next="@T["Next month"]" />
		</label>
		<label class="field f-bank">
			<span>@T["Bank name or BIC"]</span>
			<input type="search" name="bank" value="@Model.Bank" list="banks" placeholder="@T["e.g. Vietcombank or BFTVVNVX"]" autocomplete="off" />
			<datalist id="banks">
				@foreach (var b in Model.Banks)
				{
					<option value="@b.Bic">@b.Name</option>
				}
			</datalist>
		</label>
		<div class="actions">
			<a asp-page="/Index" class="btn btn-secondary">@T["Reset"]</a>
			<button type="submit" class="btn btn-primary">@T["Show rates"]</button>
		</div>
	</form>
</div>

<main class="container">
	@if (Model.Error is not null)
	{
		<p class="notice error">@Model.Error</p>
	}
	else if (Model.Results is null)
	{
		<p class="notice">
			@T["Choose a country, a date or a bank to see the latest rates."]
			@if (Model.Banks.Count > 0)
			{
				<span>@T.Format("{0} bank(s) have rates.", Model.Banks.Count)</span>
			}
		</p>
	}
	else if (Model.Results.Count == 0)
	{
		<p class="notice">
			@(Model.Date is { } d
				? T.Format("No rates match this search on or before {0}.", RateFormat.FormatDate(d))
				: T["No rates match this search."])
		</p>
	}
	else
	{
		var featured = Model.Featured;
		if (featured.Count > 0)
		{
			<div class="featured">
				@foreach (var f in featured)
				{
					var spread = RateFormat.Spread(f);
					<div class="fcard @RateFormat.FeaturedTheme(f.CurrencyCode)">
						<div class="fcard-head">
							<span class="fcard-id">
								<span class="sym">@(f.CurrencySymbol ?? f.CurrencyCode[..1])</span>
								<span>
									<span class="fcard-code">@f.CurrencyCode</span>
									<span class="fcard-name">@f.CurrencyName</span>
								</span>
							</span>
							<span class="badge">@T.Format("Spread {0}", RateFormat.FormatSpread(spread))</span>
						</div>
						<div class="fcard-rates">
							<div><small>@T["We buy"]</small><span class="num">@RateFormat.Format(f.BuyingRateTransfer)</span></div>
							<div><small>@T["We sell"]</small><span class="num sell">@RateFormat.Format(f.SellingRate)</span></div>
						</div>
					</div>
				}
			</div>
		}

		foreach (var bank in Model.Results)
		{
			<section class="bank" data-rates>
				<div class="bank-head">
					<div class="bank-id">
						<span class="bank-badge">@bank.Badge</span>
						<div>
							<h2>@bank.ShortName</h2>
							<p>
								@(bank.LegalName ?? bank.Name)
								@if (bank.CountryName is not null)
								{
									<span> · @bank.CountryName</span>
								}
							</p>
						</div>
					</div>
					<div class="chips">
						<span class="chip blue num">@bank.Bic</span>
						@if (bank.SameDate)
						{
							<span class="chip orange">@T.Format("Rates of {0}", RateFormat.FormatDate(bank.LastDate))</span>
						}
						else
						{
							<span class="chip orange">@T.Format("Rates of {0} to {1}", RateFormat.FormatDate(bank.FirstDate), RateFormat.FormatDate(bank.LastDate))</span>
						}
						@if (bank.PublishedAt is { } published)
						{
							<span class="chip">@T.Format("Published {0} ({1})", RateFormat.FormatPublished(published), RateFormat.FormatOffset(published.Offset))</span>
						}
					</div>
				</div>
				<div class="toolbar">
					<label class="search">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#667085" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
						<input type="search" aria-label="@T["Filter currencies"]" placeholder="@T["Filter currencies"]" data-filter />
					</label>
					<span class="hint">
						@if (bank.QuoteCurrency is not null)
						{
							<text>@T.Format("All rates in {0}", bank.QuoteCurrency) · </text>
						}
						@T["“—” means the bank doesn’t quote this rate"]
					</span>
				</div>
				<div class="table-wrap">
					<table class="rates-table">
						<thead>
							<tr>
								<th>@T["Currency"]</th>
								<th>@T["Buy · cash"]</th>
								<th>@T["Buy · transfer"]</th>
								<th>@T["Sell"]</th>
								<th>@T["Spread"]</th>
							</tr>
						</thead>
						<tbody>
							@for (var i = 0; i < bank.Rates.Count; i++)
							{
								var r = bank.Rates[i];
								var spread = RateFormat.Spread(r);
								<tr data-search="@($"{r.CurrencyCode} {r.CurrencyName}".ToLowerInvariant())">
									<td>
										<span class="cur">
											<span class="pill p@(i % 5)">@r.CurrencyCode</span>
											<span class="cur-name">@r.CurrencyName</span>
											@if (!bank.SameDate)
											{
												<span class="cur-date">@RateFormat.FormatDate(r.Date)</span>
											}
										</span>
									</td>
									<td class="num @(r.BuyingRateCash is null ? "na" : "")">@RateFormat.Format(r.BuyingRateCash)</td>
									<td class="num @(r.BuyingRateTransfer is null ? "na" : "")">@RateFormat.Format(r.BuyingRateTransfer)</td>
									<td class="num sell @(r.SellingRate is null ? "na" : "")">@RateFormat.Format(r.SellingRate)</td>
									<td>
										<span class="spread">
											<span class="bar"><i style="width:@(bank.SpreadBarWidth(spread))%"></i></span>
											<span class="num">@RateFormat.FormatSpread(spread)</span>
										</span>
									</td>
								</tr>
							}
							<tr class="no-match" hidden><td colspan="5">@T["No currency matches this filter."]</td></tr>
						</tbody>
					</table>
				</div>
			</section>
		}

		<p class="footnote">@T["Rates are indicative and taken from the bank’s published table. Spread = (sell − buy transfer) ÷ buy transfer."]</p>
	}
</main>

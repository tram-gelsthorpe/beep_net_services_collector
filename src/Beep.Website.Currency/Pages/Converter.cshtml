@page
@model ConverterModel
@{
	ViewData["Title"] = T["Converter"];
	ViewData["Nav"] = "converter";
}

<main class="container">
	<h1 class="page-title">@T["Converter"]</h1>

	@if (Model.Error is not null)
	{
		<p class="notice error">@Model.Error</p>
	}
	else if (Model.Rates is null)
	{
		<p class="notice">@T["No rates match this search."]</p>
	}
	else
	{
		var bank = Model.Rates;
		var quote = bank.QuoteCurrency ?? "";

		<div class="conv-layout" data-converter="@Model.ConverterJson()">
			<section class="card conv">
				<div class="conv-top">
					<h2 class="conv-title">@T["Currency converter"]</h2>
					<div class="seg">
						<button type="button" data-dir="f2v" aria-pressed="true"></button>
						<button type="button" data-dir="v2f" aria-pressed="false"></button>
					</div>
				</div>
				<form method="get" class="conv-where">
					<label class="field">
						<span>@T["Country"]</span>
						<select name="country" onchange="this.form.elements.bank.value = ''; this.form.submit()">
							<button><selectedcontent></selectedcontent></button>
							@foreach (var c in Model.Countries)
							{
								<option value="@c.Code" selected="@(c.Code == Model.Country)">@c.Name</option>
							}
						</select>
					</label>
					<label class="field">
						<span>@T["Bank"]</span>
						<select name="bank" onchange="this.form.submit()">
							<button><selectedcontent></selectedcontent></button>
							@foreach (var b in Model.Banks)
							{
								<option value="@b.Bic" selected="@(b.Bic == Model.Bank)">@b.DisplayName</option>
							}
						</select>
					</label>
					<input type="hidden" name="currency" value="@Model.Currency" data-bank-currency />
				</form>
				<div class="conv-boxes">
					<label class="conv-box">
						<span>@T["You have"]</span>
						<span class="conv-row">
							<input data-amount inputmode="decimal" aria-label="@T["Amount"]" value="1,000" autocomplete="off" />
							<select data-currency class="cur-pill" aria-label="@T["Currency"]">
								@foreach (var r in bank.Rates)
								{
									<option value="@r.CurrencyCode" data-name="@r.CurrencyName" selected="@(r.CurrencyCode == Model.Currency)">@r.CurrencyCode · @r.CurrencyName</option>
								}
							</select>
							<span data-quote-in class="cur-pill" hidden>@quote</span>
						</span>
					</label>
					<button type="button" class="swap" data-swap aria-label="@T["Swap direction"]" title="@T["Swap direction"]">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3" /></svg>
					</button>
					<div class="conv-box out">
						<span>@T["You get"]</span>
						<span class="conv-row">
							<output data-result aria-live="polite"></output>
							<span data-to class="cur-pill">@quote</span>
						</span>
					</div>
				</div>
				<div class="conv-mode">
					<span class="rate-line" data-rate-line></span>
					<div class="seg light" data-mode-seg>
						<button type="button" data-mode="transfer" aria-pressed="true">@T["Transfer"]</button>
						<button type="button" data-mode="cash" aria-pressed="false">@T["Cash"]</button>
					</div>
				</div>
				<div class="chips-row" data-quick></div>
			</section>

			<aside class="conv-side">
				<section class="card">
					<div class="bank-cell">
						<span class="bank-dot bank-dot-lg">@bank.Badge</span>
						<span>
							<b class="conv-bank-name">@(bank.DisplayName)@if (bank.IsReferenceRate) { <span class="ref-tag" tabindex="0" data-tip="@T["A central bank’s reference rate: one middle rate, published for information, not a bank’s buying and selling prices."]">@T["Reference rate"]</span> }</b>
							@if (bank.FullName is not null) { <small class="bank-full-name">@bank.FullName</small> }
							<small class="conv-bank-meta">
								@* A line each, so the time never breaks off on its own ("published 25/11" / "23:00"). *@
								<span>@T.Format("Rates of {0}", RateFormat.FormatDate(bank.LastDate))</span>
								@if (bank.PublishedAt is { } published)
								{
									<span>@T.Format("published {0}", RateFormat.FormatPublished(published))</span>
								}
							</small>
						</span>
					</div>
					<div>
						<div class="kv"><span>@DotLabel.BreakOnlyAfterDot(T["Bank buys · cash"])</span><span class="num" data-r-cash></span></div>
						<div class="kv"><span>@DotLabel.BreakOnlyAfterDot(T["Bank buys · transfer"])</span><span class="num" data-r-transfer></span></div>
						<div class="kv"><span>@T["Bank sells"]</span><span class="num kv-sell" data-r-sell></span></div>
					</div>
					<a class="btn-link" data-compare-link href="#"></a>
				</section>
				<section class="card conv-help">
					<b>@T["How it works"]</b>
					<span>@T.Format("Changing foreign currency into {0} uses the bank’s buy rate. Changing {0} into foreign currency uses the bank’s sell rate. Cash rates are usually lower than transfer rates.", quote)</span>
				</section>
			</aside>
		</div>

		<section class="card tiles-card">
			<div class="tiles-head">
				<h2>@T.Format("1 unit in {0} today", quote)</h2>
				<span>@T["Bank buys (transfer) · Bank sells — click to convert"]</span>
			</div>
			<div class="tiles">
				@for (var i = 0; i < bank.Rates.Count; i++)
				{
					var r = bank.Rates[i];
					<button type="button" class="tile" data-tile="@r.CurrencyCode" aria-pressed="@(r.CurrencyCode == Model.Currency ? "true" : "false")">
						<span class="pill p@(i % 5)">@r.CurrencyCode</span>
						<span class="num tile-buy">@RateFormat.Format(r.BuyingRateTransfer)</span>
						<span class="num tile-sell">@T.Format("sell {0}", RateFormat.Format(r.SellingRate))</span>
					</button>
				}
			</div>
		</section>

		<p class="footnote">@T.Format("Results are estimates based on {0}’s published rates and may differ from the amount you receive at the counter.", bank.DisplayName)</p>
	}
</main>

@section Scripts {
	<script src="~/js/converter.js" asp-append-version="true"></script>
}

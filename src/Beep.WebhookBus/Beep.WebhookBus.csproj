  <ItemGroup>
    <ProjectReference Include="../Beep.ServiceBus/Beep.ServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
